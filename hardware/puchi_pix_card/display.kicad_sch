	(text "Scan: ROW r = anode bus (ROW0 top), driven by Q1xx (AO3401A high side from +5V) via 74HCT595 SR_Q r."
		(exclude_from_sim no)
		(at 299.72 299.72 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "83503bfb-a365-4d27-9674-e055c4ce0fc9")
	)
	(text "Columns: COL_R/G/B c = cathode buses (COL0 left) -> MBI5124 OUT c. Chain MCU SDI -> U101(R) -> U102(G) -> U103(B) -> MCU SDO. Grayscale is made by the MCU (BCM via /OE on pin 21)."
		(exclude_from_sim no)
		(at 299.72 303.53 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "880140fe-1e89-4691-8ee4-31dac56680bb")
	)
	(text "Rext: IOUT=(1.23V/Rext)x15 (MBI5124 p14) -> R 2.0k=9.2mA (+120R series drop), G 2.4k=7.7mA, B 4.7k=3.9mA. Limit at VDD=3.3V is 10mA (p8); no current gain register. Red series 120R: on USB (+5V >= 4.0V after D1) worst-case red VF 2.4V + 1.11V + VDS 0.5V = 4.0V."
		(exclude_from_sim no)
		(at 299.72 306.07 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
